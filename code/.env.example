# Namespaces must match the IRIs used in your imported ontology and knowledge graph.
ONTOLOGY_NAMESPACE=https://cfaa.eus/ontology/industrial/
KG_NAMESPACE=https://cfaa.eus/kg/brochadora/
ASSETS_NAMESPACE=https://cfaa.eus/assets/

# GraphDB repository SPARQL endpoint (no embedded credentials).
GRAPHDB_ENDPOINT=http://localhost:7200/repositories/broaching
GRAPHDB_USER=
GRAPHDB_PASSWORD=
GRAPHDB_TOKEN=
# Set either GRAPHDB_USER / GRAPHDB_PASSWORD OR GRAPHDB_TOKEN, never both.
GRAPHDB_TIMEOUT=30
GRAPHDB_MAX_ROWS=200
GRAPHDB_METADATA_LIMIT=5000
GRAPHDB_INFER=false

# InfluxDB 2.x: use a read-only API token with access to the required buckets.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace-with-your-read-only-token
INFLUX_ORG=my-organisation
# Optional: only necessary when GraphDB advertises multiple InfluxDB sources.
# Must be the exact source resource IRI in your knowledge graph.
INFLUX_SOURCE_URI=
INFLUX_TIMEOUT_MS=120000

# Local Ollama installation and model (download the model before running).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=300
# Leave unset unless your model supports this option: true / false.
# OLLAMA_THINK=false

# App preferences and query limits.
CONSULTA_TZ=Europe/Madrid
CONSULTA_MAX_DIAS=366
CONSULTA_MAX_PUNTOS=10000
CHAINLIT_MAX_ITEMS=20
LANGSMITH_TRACING=false