broch:prop_totalHeight a aas:Property;
  aas-ref:idShort "TotalHeight";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "5850 mm" .

broch:prop_floorSpaceRequired a aas:Property;
  aas-ref:idShort "FloorSpaceRequired";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "4000 x 5000 mm" .

broch:prop_totalWeight a aas:Property;
  aas-ref:idShort "TotalWeight";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "25 Tn" .

broch:prop_requiredFloorLoadCapacity a aas:Property;
  aas-ref:idShort "RequiredFloorLoadCapacity";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "7 Tn/m^2" .

broch:prop_coolantTankCapacity a aas:Property;
  aas-ref:idShort "CoolantTankCapacity";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "2000 L" .

broch:prop_coolantType a aas:Property;
  aas-ref:idShort "CoolantType";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "CUT-MAX S 50259-1 (14cSt - 40ºC)" .

broch:prop_lubricationOilType a aas:Property;
  aas-ref:idShort "LubricationOilType";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "ISO 3498 G220 (220cSt - 40ºC)" .

broch:prop_greaseType a aas:Property;
  aas-ref:idShort "GreaseType";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Alpha G11 NLGI 0-1 (149cSt - 40ºC)" .

broch:prop_hydraulicOilType a aas:Property;
  aas-ref:idShort "HydraulicOilType";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "ISO 3498 HM46 (46cSt - 40º)" .

broch:prop_soundPressureLevel a aas:Property;
  aas-ref:idShort "SoundPressureLevel";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "<78 dB" .

broch:coll_zocalo a aas:SubmodelElementCollection;
  aas-ref:idShort "Zocalo";
  aas-smc:value broch:prop_zocalo_descripcion .

broch:coll_columna a aas:SubmodelElementCollection;
  aas-ref:idShort "Columna";
  aas-smc:value broch:prop_columna_descripcion .

broch:coll_carroPortaPiezas a aas:SubmodelElementCollection;
  aas-ref:idShort "CarroPortaPiezas";
  aas-smc:value broch:prop_carroPortaPiezas_descripcion, broch:coll_carroPortaPiezas_frenos .

broch:coll_platoDivisor a aas:SubmodelElementCollection;
  aas-ref:idShort "PlatoDivisor";
  aas-smc:value broch:prop_platoDivisor_descripcion, broch:prop_platoDivisor_bases,
    broch:coll_platoDivisor_mecanismo, broch:coll_platoDivisor_senales .

broch:coll_carroPortaBrochas a aas:SubmodelElementCollection;
  aas-ref:idShort "CarroPortaBrochas";
  aas-smc:value broch:prop_carroPortaBrochas_descripcion .

broch:prop_zocalo_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "El zócalo es la base de la máquina sobre el que se monta la columna. A su vez, hace de depósito de refrigerante, donde se va acumulando el aceite y la viruta durante el proceso de brochado y desde el que se envía al extractor de virutas para separar el aceite de la viruta." .

broch:prop_columna_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Sobre el zócalo se monta la columna con dos guías lineales por las que se desplaza el carro porta-piezas, siendo el recorrido máximo de 3000 mm. La posición del carro se controla a través de dos reglas lineales colocadas en el lateral de la columna. Dispone de juegos de sistemas piñón/cremallera (WITTENSTEIN) accionados por dos servomotores colocados sobre el carro porta-piezas que provocan su movimiento. El movimiento se realiza a una velocidad máxima de 40 m/min de avance y 40 m/min de retroceso. La fuerza máxima desarrollada en este movimiento es de 70 kN." .

broch:prop_carroPortaPiezas_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "El carro porta-piezas lleva seis patines y dos bloqueos hidráulicos en la parte posterior. Para equilibrar el peso del carro, hay colocadas dos guías en la parte trasera de la columna por las que se desplazan dos contrapesos. Cada uno lleva instalados dos patines y un bloqueo hidráulico." .

broch:coll_carroPortaPiezas_frenos a aas:SubmodelElementCollection;
  aas-ref:idShort "Frenos";
  aas-smc:value broch:coll_freno_BQ715, broch:coll_freno_BQ717, broch:coll_freno_BQ720,
    broch:coll_freno_BQ721, broch:coll_freno_BQ723, broch:coll_freno_BQ724 .

