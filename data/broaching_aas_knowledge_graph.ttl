broch:prop_platoDivisor_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "El plato divisor va colocado sobre el carro porta-piezas y dispone de un dentado Hirth con capacidad para hacer divisiones de 1º. Con ello se pueden obtener todos los ángulos múltiplos de 1º, permitiendo la programación y realización de una sucesión de ángulos iguales o desiguales. Sobre el plato divisor se amarra con tornillos el disco Iconel a brochar." .

broch:prop_platoDivisor_bases a aas:Property;
  aas-ref:idShort "Bases";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Dispone de dos bases: una plana para brochar a 0º y otra inclinada para brochar a 15º." .

broch:coll_platoDivisor_mecanismo a aas:SubmodelElementCollection;
  aas-ref:idShort "Mecanismo";
  aas-smc:value broch:prop_platoDivisor_mec_cilindro, broch:prop_platoDivisor_mec_servomotor .

broch:coll_platoDivisor_senales a aas:SubmodelElementCollection;
  aas-ref:idShort "Senales";
  aas-smc:value broch:coll_senal_SQ46, broch:coll_senal_SQ47 .

broch:prop_platoDivisor_mec_cilindro a aas:Property;
  aas-ref:idShort "CilindroHidraulico";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Permite que el engranaje superior del dentado HIRTH se mueva verticalmente, liberando los dientes del engranaje inferior. De esta manera se desbloquea el dentado HIRTH y el plato divisor queda listo para girar." .

broch:prop_platoDivisor_mec_servomotor a aas:Property;
  aas-ref:idShort "Servomotor";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Gira el plato una vez que el dentado HIRTH está liberado." .

broch:coll_senal_SQ46 a aas:SubmodelElementCollection;
  aas-ref:idShort "SQ46";
  aas-smc:value broch:prop_SQ46_descripcion, broch:prop_SQ46_estado .

broch:coll_senal_SQ47 a aas:SubmodelElementCollection;
  aas-ref:idShort "SQ47";
  aas-smc:value broch:prop_SQ47_descripcion, broch:prop_SQ47_estado .

broch:prop_SQ46_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Mesa abajo (bloqueado)" .

broch:prop_SQ46_estado a aas:Property;
  aas-ref:idShort "Estado";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "PENDIENTE_TIEMPO_REAL" .

broch:prop_SQ47_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Mesa arriba (desbloqueado)" .

broch:prop_SQ47_estado a aas:Property;
  aas-ref:idShort "Estado";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "PENDIENTE_TIEMPO_REAL" .

broch:prop_carroPortaBrochas_descripcion a aas:Property;
  aas-ref:idShort "Descripcion";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "Sobre el carro porta-brochas van amarradas las herramientas y está fijado a la columna. Permanece quieto durante el proceso de mecanizado, ya que el desplazamiento lo realiza el carro porta-piezas." .
