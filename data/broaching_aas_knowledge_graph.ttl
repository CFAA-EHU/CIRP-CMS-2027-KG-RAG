broch:environment a aas:Environment;
  aas-env:assetAdministrationShells broch:aas;
  aas-env:submodels broch:sm_nameplate, broch:sm_technicalData, broch:sm_physicalStructure,
    broch:sm_dimensions, broch:sm_commissioning .

broch:aas a aas:AssetAdministrationShell;
  aas-id:id "urn:cfaa:brochadora:001";
  aas-aas:assetInformation broch:assetInfo;
  aas-aas:submodels broch:sm_nameplate, broch:sm_technicalData, broch:sm_physicalStructure,
    broch:sm_dimensions, broch:sm_commissioning .

broch:sm_nameplate a aas:Submodel;
  aas-id:id "urn:cfaa:brochadora:001:sm:Nameplate";
  aas-ref:idShort "Nameplate";
  aas-sm:submodelElements broch:prop_manufacturer, broch:prop_model .

broch:sm_technicalData a aas:Submodel;
  aas-id:id "urn:cfaa:brochadora:001:sm:TechnicalData";
  aas-ref:idShort "TechnicalData";
  aas-sm:submodelElements broch:prop_workpieceMaterial, broch:prop_supplyVoltage, broch:prop_totalInstalledPower,
    broch:prop_maxWorkingForce, broch:prop_maxCuttingSpeed, broch:prop_maxReturnSpeed,
    broch:prop_maxStroke, broch:prop_panelWidth, broch:prop_numberOfBroachingStations,
    broch:prop_maxBroachLength, broch:prop_compressedAirPressure, broch:prop_totalHeight,
    broch:prop_floorSpaceRequired, broch:prop_totalWeight, broch:prop_requiredFloorLoadCapacity,
    broch:prop_coolantTankCapacity, broch:prop_coolantType, broch:prop_lubricationOilType,
    broch:prop_greaseType, broch:prop_hydraulicOilType, broch:prop_soundPressureLevel .

broch:sm_physicalStructure a aas:Submodel;
  aas-id:id "urn:cfaa:brochadora:001:sm:PhysicalStructure";
  aas-ref:idShort "PhysicalStructure";
  aas-sm:submodelElements broch:coll_zocalo, broch:coll_columna, broch:coll_carroPortaPiezas,
    broch:coll_platoDivisor, broch:coll_carroPortaBrochas .

broch:assetInfo a aas:AssetInformation;
  aas-ai:globalAssetId "urn:cfaa:brochadora:001";
  aas-ai:assetKind <https://admin-shell.io/aas/3/1/AssetKind/Instance> .

