  aas-ref:idShort "SupplyVoltage";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "3x380 VAC - 50Hz" .

broch:prop_totalInstalledPower a aas:Property;
  aas-ref:idShort "TotalInstalledPower";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "57 kW" .

broch:prop_maxWorkingForce a aas:Property;
  aas-ref:idShort "MaxWorkingForce";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "70 kN" .

broch:prop_maxCuttingSpeed a aas:Property;
  aas-ref:idShort "MaxCuttingSpeed";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "40 m/min" .

broch:prop_maxReturnSpeed a aas:Property;
  aas-ref:idShort "MaxReturnSpeed";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "40 m/min" .

broch:prop_maxStroke a aas:Property;
  aas-ref:idShort "MaxStroke";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "3000 mm" .

broch:prop_panelWidth a aas:Property;
  aas-ref:idShort "PanelWidth";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "330 mm" .

broch:prop_numberOfBroachingStations a aas:Property;
  aas-ref:idShort "NumberOfBroachingStations";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "1" .

broch:prop_maxBroachLength a aas:Property;
  aas-ref:idShort "MaxBroachLength";
  aas-prop:valueType <https://admin-shell.io/aas/3/1/DataTypeDefXsd/String>;
  aas-prop:value "2640 mm" .

broch:prop_compressedAirPressure a aas:Property;
  aas-ref:idShort "CompressedAirPressure";
